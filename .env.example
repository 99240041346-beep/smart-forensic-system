# Smart Forensic System environment
NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# Local development database. Render supplies its own PostgreSQL DATABASE_URL.
DATABASE_URL="file:./dev.db"

# Replace in production with a long random secret.
JWT_SECRET="replace-with-a-long-random-jwt-secret"
LOCAL_AGENT_TOKEN="replace-with-a-long-random-agent-token"

# Local ADB executable
ADB_PATH="C:\\Users\\YOUR_USER\\Downloads\\platform-tools-latest-windows\\platform-tools\\adb.exe"

# Local agent -> Render API bridge
LOCAL_AGENT_MODE="true"
PUBLIC_API_URL="https://smart-forensic-api.onrender.com"
LOCAL_AGENT_ID="investigator-pc"
AGENT_POLL_MS="2000"
AGENT_OFFLINE_MS="10000"

# Optional threat intelligence
THREAT_INTELLIGENCE_API_KEY=""
THREAT_INTELLIGENCE_PROVIDER="offline_heuristics"

# Web frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
