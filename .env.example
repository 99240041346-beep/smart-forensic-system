# Smart Forensic System environment
NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# Local PostgreSQL. Render supplies its own PostgreSQL DATABASE_URL.
DATABASE_URL="postgresql://forensic_ci:forensic_ci@localhost:5432/smart_forensics_ci?schema=public"

# Replace in production with long random secrets. Never commit real values.
JWT_SECRET="replace-with-a-long-random-jwt-secret"
LOCAL_AGENT_TOKEN="replace-with-a-long-random-agent-token"

# Windows ADB executable used only by the investigator workstation.
ADB_PATH="C:\\Users\\YOUR_USER\\Downloads\\platform-tools-latest-windows\\platform-tools\\adb.exe"

# Local agent -> public Render API bridge.
LOCAL_AGENT_MODE="true"
PUBLIC_API_URL="https://YOUR-RENDER-API.onrender.com"
LOCAL_AGENT_ID="investigator-windows"
AGENT_POLL_MS="2000"
AGENT_OFFLINE_MS="15000"

# Web frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
